# Required: routing decisions (default provider) and the one-time media OCR/ASR pass.
GEMINI_API_KEY=

# Optional: only needed if you run with LLM_PROVIDER=groq.
GROQ_API_KEY=

# --- Failover providers (optional) ---
# Free allowances are spent first; these are only reached once Gemini and Groq run
# out, and are rationed by MAX_PAID_CALLS so a run cannot drain a prepaid balance.

# OrcaRouter: Anthropic-compatible gateway
ANTHROPIC_BASE_URL=https://api.orcarouter.ai
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=orcarouter/auto

# Any OpenAI-compatible endpoint
OPENROUTER_API_KEY=

# --- Optional overrides ---
#   LLM_PROVIDER=gemini|groq|orcarouter|openrouter   who answers routing calls
#   MAX_PAID_CALLS=150      ceiling on paid-provider calls per run; 0 refuses them
#   CALL_DELAY_SECONDS=1.0  pause between calls, to stay under rate limits
#   AGENT_ENABLED=0         agentic evidence loop; measured, off by default
#   AGENT_MAX_ROUNDS=2      tool-call rounds allowed when the agent is on
