# Required: routing decisions (default provider) and the one-time media OCR/ASR pass.
GEMINI_API_KEY=

# Optional: only needed if you run with LLM_PROVIDER=groq.
GROQ_API_KEY=

# Optional overrides:
#   LLM_PROVIDER=gemini|groq   which provider answers the per-message routing call
#   CALL_DELAY_SECONDS=1.0     pause between calls, to stay under free-tier rate limits

# Optional: OrcaRouter (Anthropic-compatible gateway), used as quota failover
ANTHROPIC_BASE_URL=https://api.orcarouter.ai
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=orcarouter/auto

# Optional: second failover, any OpenAI-compatible endpoint
OPENROUTER_API_KEY=
